# Application Port
PORT=5000

# Database URL (SQLite default for zero-config local development; can switch to postgresql:// or mysql://)
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin console authentication
JWT_SECRET="acowale_super_secret_jwt_key_2026"

# Environment: development | production | test
NODE_ENV="development"

# CORS Allowed Origin (e.g., http://localhost:3000 or * for public demo)
CORS_ORIGIN="*"

# API Rate Limit (requests per 15 minutes window per IP)
RATE_LIMIT_MAX=100
